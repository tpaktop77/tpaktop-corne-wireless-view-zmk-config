#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// Match QMK quick-tap repeat behavior for layer-tap keys.
&lt {
        quick-tap-ms = <250>;
};

/ {
        macros {
                // Types "  e" (Space, Space, E).
                oryx_m11: oryx_m11 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp SPACE &kp SPACE &kp E>;
                };

                // Vim: force quit without saving (Esc, :q!, Enter).
                oryx_m12: oryx_m12 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp ESC &kp COLON &kp Q &kp EXCL &kp RET>;
                };

                // Vim: write the current file (Esc, :w, Enter).
                oryx_m13: oryx_m13 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp ESC &kp COLON &kp W &kp RET>;
                };

                // Types " gg" (Space, G, G).
                oryx_m14: oryx_m14 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp SPACE &kp G &kp G>;
                };

                // Vim: quit the current window (Esc, :q, Enter).
                oryx_m15: oryx_m15 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp ESC &kp COLON &kp Q &kp RET>;
                };

                // Vim: write and quit (Esc, :wq, Enter).
                oryx_m16: oryx_m16 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp ESC &kp COLON &kp W &kp Q &kp RET>;
                };

                // Types " tb" (Space, T, B).
                oryx_m17: oryx_m17 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp SPACE &kp T &kp B>;
                };

                // Vim: close the current window (Ctrl-W, q).
                oryx_m18: oryx_m18 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp LC(W) &kp Q>;
                };

                // Vim: create a horizontal split (Esc, :sp, Enter).
                oryx_m19: oryx_m19 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp ESC &kp COLON &kp S &kp P &kp RET>;
                };

                // Vim: create a vertical split (Esc, :vsp, Enter).
                oryx_m20: oryx_m20 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp ESC &kp COLON &kp V &kp S &kp P &kp RET>;
                };

                // Vim: send the window-command prefix (Ctrl-W).
                oryx_m21: oryx_m21 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp LC(W)>;
                };

                // Types ". ~/".
                oryx_m22: oryx_m22 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp DOT &kp SPACE &kp TILDE &kp FSLH>;
                };

                // Types "~/".
                oryx_m23: oryx_m23 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp TILDE &kp FSLH>;
                };

                // Types "../".
                oryx_m24: oryx_m24 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp DOT &kp DOT &kp FSLH>;
                };

                // Types "./".
                oryx_m25: oryx_m25 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp DOT &kp FSLH>;
                };

                // Types ". ./".
                oryx_m26: oryx_m26 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp DOT &kp SPACE &kp DOT &kp FSLH>;
                };

                // Types "8-O".
                oryx_m27: oryx_m27 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp N8 &kp MINUS &kp LS(O)>;
                };

                // Types ":-|".
                oryx_m28: oryx_m28 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp COLON &kp MINUS &kp PIPE>;
                };

                // Types colon, minus, and backslash.
                oryx_m29: oryx_m29 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp COLON &kp MINUS &kp BSLH>;
                };

                // Types ":`[".
                oryx_m30: oryx_m30 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp COLON &kp GRAVE &kp LBKT>;
                };

                // Types ":D".
                oryx_m31: oryx_m31 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp COLON &kp LS(D)>;
                };

                // Types ":)".
                oryx_m32: oryx_m32 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp COLON &kp RPAR>;
                };

                // Types ":(".
                oryx_m33: oryx_m33 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp COLON &kp LPAR>;
                };

                // Types ":-E".
                oryx_m34: oryx_m34 {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <40>;
                        tap-ms = <40>;
                        bindings = <&kp COLON &kp MINUS &kp LS(E)>;
                };
        };

        combos {
                compatible = "zmk,combos";

                enter_combo {
                        timeout-ms = <50>;
                        key-positions = <19 20 21>;
                        bindings = <&kp RET>;
                        layers = <0 1 2>;
                };

                tab_combo {
                        timeout-ms = <50>;
                        key-positions = <14 15 16>;
                        bindings = <&kp TAB>;
                        layers = <0 1 2>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                  | LWR | BSP/7 | DEL/3 |   | TAB/5 | SPC/4 | RSE |
                        display-name = "Base";
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &mo 1 &lt 7 BSPC &lt 3 DEL   &lt 5 TAB &lt 4 SPACE &mo 2
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
// | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
//                  |     | BSP/7 | DEL/3 |   | TAB/5 | SPC/4 | RSE |
                        display-name = "Lower";
                        bindings = <
   &kp TAB    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
   &kp LSHFT  &trans       &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &trans
                                   &trans       &trans       &trans         &trans   &trans   &trans
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                  | LWR | BSP/7 | DEL/3 |   | TAB/5 | SPC/4 |     |
                        display-name = "Raise";
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp BSPC
   &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT        &kp RBKT &kp BSLH &kp GRAVE
   &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE &kp TILDE
                          &trans   &trans &trans   &trans &trans &trans
                        >;
                };

                numbers_layer {
// -----------------------------------------------------------------------------------------
// | ENT |  <  |  >  |  (  |  )  |     |   |  =  |  7  |  8  |  9  |     |  -  |
// | TAB | ALT | GUI | SHFT| CTRL|     |   |     |  4  |  5  |  6  |  .  |  /  |
// |     |  {  |  }  |  [  |  ]  |     |   |  .  |  1  |  2  |  3  |  =  |  *  |
//                    |     |     |     |   |     |     |     |
                        display-name = "Numbers";
                        bindings = <
   &kp RET &kp LESS_THAN &kp GREATER_THAN &kp LPAR &kp RPAR &none   &kp EQUAL &kp N7 &kp N8 &kp N9 &none &kp MINUS
   &kp TAB &kp LALT &kp LGUI &kp LSHFT &kp LCTRL &none              &none &kp N4 &kp N5 &kp N6 &kp DOT &kp FSLH
   &none &kp LBRC &kp RBRC &kp LBKT &kp RBKT &none                  &kp DOT &kp N1 &kp N2 &kp N3 &kp EQUAL &kp ASTRK
                  &trans &trans &trans   &lt 6 ESC &kp N0 &trans
                        >;
                };

                navigation_layer {
// -----------------------------------------------------------------------------------------
// | ENT | PREV | NEXT | STOP | PLAY | VOICE |   | PGUP | HOME |  UP  | END |     | CTRL-W |
// | TAB | LALT | LGUI | LSFT | LCTL | MUTE  |   | PGDN | LEFT | DOWN | RGT |     | CTRL-T |
// |     | VOLD | VOLU |      |      |       |   |      | P-TAB| N-TAB| P-DESK | N-DESK | INS |
//                    |     |     |     |   |     |     |     |
                        display-name = "Navigation";
                        bindings = <
   &kp RET &kp C_PREV &kp C_NEXT &kp C_STOP &kp C_PP &kp C_VOICE_COMMAND   &kp PG_UP &kp HOME &kp UP &kp END &none &kp LC(W)
   &kp TAB &kp LALT &kp LGUI &kp LSHFT &kp LCTRL &kp C_MUTE               &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &none &kp LC(T)
   &none &kp C_VOL_DN &kp C_VOL_UP &none &none &none                      &none &kp LC(LS(TAB)) &kp LC(TAB) &kp LG(LC(LEFT)) &kp LG(LC(RIGHT)) &kp INS
                  &trans &trans &trans   &trans &trans &trans
                        >;
                };

                function_layer {
// -----------------------------------------------------------------------------------------
// | ENT | F1   | F2   | F3   | F4   | F5   |   | F6   | F7   | F8   | F9   | F10  |      |
// | TAB | LALT | LGUI | LSFT | LCTL |      |   |      | RCTL | RSFT | RGUI | RALT |      |
// |     | F11  | F12  | F13  | F14  | F15  |   | F16  | F17  | F18  | F19  | F20  |      |
//                    |     |     |     |   |     |     |     |
                        display-name = "Function";
                        bindings = <
   &kp RET &kp F1 &kp F2 &kp F3 &kp F4 &kp F5                 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &none
   &kp TAB &kp LALT &kp LGUI &kp LSHFT &kp LCTRL &none        &none &kp RCTRL &kp RSHFT &kp RGUI &kp RALT &none
   &none &kp F11 &kp F12 &kp F13 &kp F14 &kp F15              &kp F16 &kp F17 &kp F18 &kp F19 &kp F20 &none
                  &trans &trans &lt 6 DEL   &trans &trans &trans
                        >;
                };

                vim_layer {
// -----------------------------------------------------------------------------------------
// |  :  |     | M11 | M12 | M13 | M14 |   | M18 | M19 |  K  | M20 |     |     |
// |     |     |     | M15 | M16 | M17 |   | M21 |  H  |  J  |  L  |     |     |
// |     |     |     |     |     |     |   |     |     |     |     |     |     |
//                    |     |     |     |   |     |     |     |
                        display-name = "Vim";
                        bindings = <
   &kp COLON &none &oryx_m11 &oryx_m12 &oryx_m13 &oryx_m14   &oryx_m18 &oryx_m19 &kp K &oryx_m20 &none &none
   &none &none &none &oryx_m15 &oryx_m16 &oryx_m17           &oryx_m21 &kp H &kp J &kp L &none &none
   &none &none &none &none &none &none                       &none &none &none &none &none &none
                  &trans &trans &trans   &trans &trans &trans
                        >;
                };

                symbols_layer {
// -----------------------------------------------------------------------------------------
// |  `  |  <  |  >  |  (  |  )  |     |   |  #  |  _  |  -  |  /  |  \\  |  -  |
// | M22 | M23 | M24 | M25 |  /  |  |  |   |  @  |  .  |  ,  |  !  |  ?  |  /  |
// | M26 |  {  |  }  |  [  |  ]  |     |   |  '  |  \"  |  :  |  ;  |  =  |  *  |
//                    |     |     |     |   |     |     |     |
                        display-name = "Symbols";
                        bindings = <
   &kp GRAVE &kp LESS_THAN &kp GREATER_THAN &kp LPAR &kp RPAR &none   &kp HASH &kp UNDER &kp MINUS &kp FSLH &kp BSLH &kp MINUS
   &oryx_m22 &oryx_m23 &oryx_m24 &oryx_m25 &kp FSLH &kp PIPE         &kp AT &kp DOT &kp COMMA &kp EXCL &kp QMARK &kp FSLH
   &oryx_m26 &kp LBRC &kp RBRC &kp LBKT &kp RBKT &none               &kp SQT &kp DQT &kp COLON &kp SEMI &kp EQUAL &kp ASTRK
                  &trans &trans &trans   &trans &lt 8 SPACE &trans
                        >;
                };

                smiles_layer {
// -----------------------------------------------------------------------------------------
// |     |     |     |     |     |     |   | M27 | M28 | M29 | M30 |     |     |
// |     |     |     |     |     |     |   | M31 | M32 | M33 | M34 |     |     |
// |     |     |     |     |     |     |   |     |     |     |     |     |     |
//                    |     |     |     |   |     |     |     |
                        display-name = "Smiles";
                        bindings = <
   &none &none &none &none &none &none   &oryx_m27 &oryx_m28 &oryx_m29 &oryx_m30 &none &none
   &none &none &none &none &none &none   &oryx_m31 &oryx_m32 &oryx_m33 &oryx_m34 &none &none
   &none &none &none &none &none &none   &none &none &none &none &none &none
                  &trans &trans &trans   &trans &trans &trans
                        >;
                };

                extra_1 {
                        status = "reserved";
                };

                extra_2 {
                        status = "reserved";
                };

                extra_3 {
                        status = "reserved";
                };
        };
};
